{
  "id": "com.localseller.pos",
  "name": "Local Seller Marketplace",
  "short_name": "Local Seller",
  "description": "Fast local product showcase, inventory catalog, barcode scanning, and point-of-sale marketplace for neighborhood shops and sellers.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "theme_color": "#78350f",
  "background_color": "#f5f5f4",
  "lang": "en",
  "dir": "ltr",
  "categories": ["business", "shopping", "productivity"],
  "prefer_related_applications": false,
  "edge_side_panel": {
    "preferred_width": 480
  },
  "icons": [
    {
      "src": "/pwa-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-maskable-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "POS Billing Register",
      "short_name": "Register",
      "description": "Open cashier billing counter and start a new sale",
      "url": "/?view=pos",
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Inventory & Stock",
      "short_name": "Inventory",
      "description": "View catalog, adjust stock, or add products",
      "url": "/?view=inventory",
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Customer Showcase",
      "short_name": "Showcase",
      "description": "Browse shop products and customer storefront",
      "url": "/?view=display",
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}

